# Application
APP_NAME=HOSIM-GO
APP_ENV=development
APP_PORT=8080

# Database Configuration
# Primary driver: postgres (or sqlite for local testing)
DB_DRIVER=postgres

# Database Name
DB_NAME=hosim_go

# PostgreSQL Settings (Used when DB_DRIVER=postgres)
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_SSLMODE=disable

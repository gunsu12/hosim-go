# Application
APP_NAME=HOSIM-GO
APP_ENV=development
APP_PORT=8080

# Database Configuration
# Supported drivers: sqlite | postgres
DB_DRIVER=sqlite

# SQLite Settings
DB_NAME=hosim.db

# PostgreSQL Settings (Used when DB_DRIVER=postgres)
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_SSLMODE=disable

# Application
APP_NAME=HOSIM-GO
APP_ENV=development
APP_PORT=8080

# Database Configuration (PostgreSQL)
DB_DRIVER=postgres
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=hosim_go
DB_SSLMODE=disable

# JWT & Authentication Settings
JWT_SECRET=hosim-secret-key-change-this-in-production-12345678
JWT_ACCESS_DURATION=60m
JWT_REFRESH_DURATION=168h

# Migration Setting (Opsional: set true jika ingin auto-migrate saat container start)
AUTO_MIGRATE=false

meta {
  name: Add Unit to General
  type: http
  seq: 7
}

post {
  url: {{baseUrl}}/items/{{generalId}}/units
  body: json
  auth: bearer
}

auth:bearer {
  token: {{token}}
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "unit_name": "Box",
    "conversion_factor": 50.0,
    "is_purchase_unit": true,
    "is_dispense_unit": false
  }
}

script:post-response {
  if (res.body && res.body.data && res.body.data.id) {
    bru.setEnvVar("unitId", res.body.data.id);
  }
}

meta {
  name: Update Unit
  type: http
  seq: 3
}

put {
  url: {{baseUrl}}/items/{{itemId}}/units/{{unitId}}
  body: json
  auth: bearer
}

auth:bearer {
  token: {{token}}
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "unit_name": "Box Besar",
    "conversion_factor": 100.0,
    "is_purchase_unit": true,
    "is_dispense_unit": false
  }
}

meta {
  name: Add Unit to Medication
  type: http
  seq: 7
}

post {
  url: {{baseUrl}}/items/{{medicationId}}/units
  body: json
  auth: bearer
}

auth:bearer {
  token: {{token}}
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "unit_name": "Strip",
    "conversion_factor": 10.0,
    "is_purchase_unit": false,
    "is_dispense_unit": true
  }
}

script:post-response {
  if (res.body && res.body.data && res.body.data.id) {
    bru.setEnvVar("unitId", res.body.data.id);
  }
}

meta {
  name: List Categories
  type: http
  seq: 1
}

get {
  url: {{baseUrl}}/item-categories?page=1&limit=10
  body: none
  auth: bearer
}

params:query {
  page: 1
  limit: 10
  ~search: farmasi
  ~item_type: MEDICATION
  ~is_active: true
}

auth:bearer {
  token: {{token}}
}

headers {
  Content-Type: application/json
}

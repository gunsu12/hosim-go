meta {
  name: Create Category
  type: http
  seq: 2
}

post {
  url: {{baseUrl}}/item-categories
  body: json
  auth: bearer
}

auth:bearer {
  token: {{token}}
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "code": "CAT-OBAT-PATEN",
    "name": "Obat Paten & Generik Farmasi",
    "item_type": "MEDICATION",
    "income_coa_code": "410.02.001",
    "discount_coa_code": "410.02.002",
    "sales_tax_coa_code": "215.01.001",
    "is_active": true
  }
}

script:post-response {
  if (res.body && res.body.data && res.body.data.id) {
    bru.setEnvVar("categoryId", res.body.data.id);
  }
}

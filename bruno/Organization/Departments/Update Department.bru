meta {
  name: Update Department
  type: http
  seq: 4
}

put {
  url: {{baseUrl}}/departments/{{departmentId}}
  body: json
  auth: bearer
}

auth:bearer {
  token: {{token}}
}

headers {
  Content-Type: application/json
}

body:json {

meta {
  name: Create Tariff Component
  type: http
  seq: 2
}

post {
  url: {{baseUrl}}/tariff-components
  body: json
  auth: bearer
}

headers {
  Content-Type: application/json
}

auth:bearer {
  token: {{token}}
}

body:json {
  {
    "code": "JM^002",
    "name": "Jasa Medis Dokter Anastesi",
    "description": "Komponen jasa medis dokter anastesiologi",
    "is_hospital_revenue": false,
    "is_operator_revenue": true,
    "is_paramedic_revenue": false
  }
}

script:post-response {
  if (res.body && res.body.data && res.body.data.id) {
    bru.setEnvVar("tariffComponentId", res.body.data.id);
  }
}

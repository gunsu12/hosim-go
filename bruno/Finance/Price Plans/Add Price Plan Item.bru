meta {
  name: Add Price Plan Item
  type: http
  seq: 12
}

post {
  url: {{baseUrl}}/price-plans/{{pricePlanId}}/items
  body: json
  auth: bearer
}

auth:bearer {
  token: {{token}}
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "item_id": "{{itemId}}",
    "tariff_class_id": "{{tariffClassId}}",
    "total_base_price": 250000.00,
    "total_cito_price": null,
    "is_active": true,
    "components": [
      {
        "component_id": "{{saranaComponentId}}",
        "base_amount": 75000.00,
        "cito_amount": null,
        "coa_code": "410.01.001"
      },
      {
        "component_id": "{{medisComponentId}}",
        "base_amount": 175000.00,
        "cito_amount": null,
        "coa_code": "214.01.001"
      }
    ]
  }
}

script:post-response {
  if (res.body && res.body.data && res.body.data.id) {
    bru.setEnvVar("pricePlanItemId", res.body.data.id);
  }
}

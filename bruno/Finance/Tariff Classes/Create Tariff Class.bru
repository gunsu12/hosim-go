meta {
  name: Create Tariff Class
  type: http
  seq: 2
}

post {
  url: {{baseUrl}}/tariff-classes
  body: json
  auth: bearer
}

auth:bearer {
  token: {{token}}
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "code": "KELAS-VIP",
    "name": "Kelas VIP",
    "is_active": true,
    "description": "Fasilitas rawat inap VIP privat"
  }
}

script:post-response {
  if (res.body && res.body.data && res.body.data.id) {
    bru.setEnvVar("tariffClassId", res.body.data.id);
  }
}

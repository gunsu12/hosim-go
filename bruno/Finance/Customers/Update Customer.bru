meta {
  name: Update Customer
  type: http
  seq: 5
}

put {
  url: {{baseUrl}}/customers/{{customerId}}
  body: json
  auth: bearer
}

auth:bearer {
  token: {{token}}
}

headers {
  Content-Type: application/json
}

body:json {
